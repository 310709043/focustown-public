# Focus Town — production env template for single-VM Lightsail deploy.
# Copy to /opt/focustown/.env on the VM, fill in REPLACE_ME values, chmod 600.
# DO NOT commit the populated file. The repo's .gitignore already excludes .env.
# Source of truth for architecture: ~/.claude/plans/aws-polymorphic-bee.md

# === Identity ===========================================================
APP_ENV=production
APP_DEBUG=false
PUBLIC_HOST=focustown.app                       # apex domain at GoDaddy
ACME_EMAIL=admin@focustown.app                  # Caddy / Let's Encrypt notices

# === Secrets (generate fresh: openssl rand -base64 32) =================
APP_SECRET_KEY=REPLACE_ME_AT_LEAST_32_CHARS_RANDOM
PG_PASSWORD=REPLACE_ME_DIFFERENT_FROM_APP_SECRET

# === Swap points — "lite" mode (no Cognito / S3 / Secrets Manager) ====
AUTH_PROVIDER=local_jwt
STORAGE_BACKEND=local
SECRETS_BACKEND=env
NOTIFIER_BACKEND=ses

# === JWT tunables (defaults are fine for MVP) ==========================
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=14

# === Password reset ====================================================
RESET_TOKEN_TTL_HOURS=1
RESET_URL_BASE=https://focustown.app/reset-password
TERMS_CURRENT_VERSION=2026-05-14                # sync with frontend/lib/config/legal.ts

# === SES (password reset emails only at this scale) ====================
AWS_REGION=ap-northeast-1
SES_FROM_EMAIL=noreply@focustown.app            # must match a verified SES identity
AWS_ACCESS_KEY_ID=REPLACE_ME_FROM_IAM_USER      # focustown-ses-sender programmatic key
AWS_SECRET_ACCESS_KEY=REPLACE_ME_FROM_IAM_USER

# === S3 backup (used by scripts/backup.sh, NOT by the app at runtime) =
# This bucket name is read by backup.sh; uses a *different* IAM user
# (focustown-backup-writer) configured via ~/.aws/credentials, not the
# env vars above.
BACKUP_S3_BUCKET=focustown-backups

# === Network posture ===================================================
APP_CORS_ORIGINS=https://focustown.app
# Caddy runs inside the docker bridge network; trust its private range so
# X-Forwarded-For from Caddy is respected by the backend rate limiter.
APP_TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12

# === Optional Cognito / S3 storage / Secrets Manager (unused) =========
# Adapters exist in code but the swap-point env vars above point at the
# "lite" implementations. Leaving these blank is intentional.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
S3_BUCKET=
