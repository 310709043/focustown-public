{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lbt-web",
  "main": "cloudflare-worker.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // Redirect apex requests before serving any assets.
    "run_worker_first": true
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "lbt-web" }
  ],
  "routes": [
    { "pattern": "www.lowbatterytown.com", "custom_domain": true },
    { "pattern": "lowbatterytown.com", "custom_domain": true }
  ]
}
