{
  "name": "lowbatterytown-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "gen:api": "openapi-typescript http://localhost:8000/openapi.json -o ./lib/api/types.gen.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "qa": "pnpm build && pnpm start",
    "cf:build": "opennextjs-cloudflare build && node scripts/build-csp.mjs",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "pnpm cf:build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@sentry/nextjs": "^11.4.0",
    "clsx": "^2.1.1",
    "next": "15.5.27",
    "next-intl": "^4.14.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^3.23.8",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@mediapipe/tasks-vision": "^0.10.35",
    "@opennextjs/cloudflare": "^1.20.7",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.14.0",
    "eslint-config-next": "15.5.27",
    "jsdom": "^25.0.1",
    "msw": "^2.6.6",
    "openapi-typescript": "^7.4.4",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^7.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.23",
      "js-yaml@^4": "^4.3.2",
      "brace-expansion@^1": "^1.1.21",
      "brace-expansion@^2": "^2.1.7",
      "brace-expansion@^4": "^5.0.12",
      "fast-uri@^3": "^3.1.8",
      "ws@^8": "^8.21.0",
      "nanoid@^3": "^3.3.18",
      "form-data@^4": "^4.0.6",
      "uuid@^9": "^11.1.1",
      "esbuild@<0.25.0": "^0.25.0",
      "browserslist": "^4.28.7",
      "baseline-browser-mapping": "^2.11.0",
      "postcss-selector-parser@^6": "^6.1.3",
      "brace-expansion@^5": "^5.0.12",
      "@babel/core": "^7.29.6"
    }
  },
  "packageManager": "pnpm@9.15.9"
}
