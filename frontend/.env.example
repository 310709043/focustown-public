# Backend API (required in production)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000

# Site URL for meta tags / OG images
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated origins allowed in media CSP (optional)
# NEXT_PUBLIC_MEDIA_ALLOWED_ORIGINS=https://cdn.example.com

# Broadcast proxy base URL (optional, for SSE relay)
# NEXT_PUBLIC_BROADCAST_PROXY_BASE_URL=https://broadcast.example.com
