# Reverse proxy for Focus Town inside the Lightsail Container Service.
# LCS terminates TLS at the public endpoint and proxies HTTP to caddy:80,
# so this file does NOT issue certs or listen on 443 — that's LCS's job.
# Routing must stay in this file because LCS's public endpoint maps to a
# single (container, port) pair; Caddy is the per-path router.
#
# Inter-container hostnames use the LCS private-domain pattern
# `<SERVICE>.service.local:<port>` — empirically `localhost` only sometimes
# works (probably an internal-routing quirk for the first port-declared
# container) and the AWS docs explicitly recommend the private domain. The
# service name is environment-specific (lowbatterytown-dev vs
# lowbatterytown-prod), so we parameterize via the SERVICE_HOST env var so
# the same Caddyfile baked into the custom caddy image works for both envs.
# Ref: https://docs.aws.amazon.com/lightsail/latest/userguide/amazon-lightsail-container-services.html

:80 {
    encode gzip zstd

    # WebSocket upgrade — must come before /api/* generic match.
    # Caddy v2 reverse_proxy already handles Upgrade headers, but listing
    # the path explicitly keeps intent obvious.
    @ws path /api/v1/ws/*
    handle @ws {
        reverse_proxy {$SERVICE_HOST}:8000
    }

    # Backend API
    handle /api/* {
        reverse_proxy {$SERVICE_HOST}:8000
    }
    handle /healthz {
        reverse_proxy {$SERVICE_HOST}:8000
    }
    handle /ready {
        reverse_proxy {$SERVICE_HOST}:8000
    }
    handle /docs* {
        reverse_proxy {$SERVICE_HOST}:8000
    }
    handle /openapi.json {
        reverse_proxy {$SERVICE_HOST}:8000
    }

    # Frontend SSR (catch-all, last)
    handle {
        reverse_proxy {$SERVICE_HOST}:3000
    }

    # Defence-in-depth headers (backend SecurityHeadersMiddleware emits these
    # too, but Caddy sees frontend responses which the middleware can't reach).
    # HSTS still useful: LCS speaks HTTPS to the browser, so the header reaches
    # the client even though Caddy itself is plaintext.
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(self), microphone=(), geolocation=(), interest-cohort=()"
        -Server
    }

    # Cache-busting for HTML / SSR responses. Without this, browsers and
    # any upstream CDN cache the App Router HTML shell after a deploy, so
    # users keep seeing the old build until they manually hard-refresh.
    # Hashed static assets under /_next/static/* keep Next.js's built-in
    # `immutable` long-cache (handled by the framework itself, not here),
    # so we narrowly opt only the dynamic surfaces out of cacheing.
    @dynamic {
        not path /_next/static/*
        not path /assets/*
        not path /audio/*
        not path /favicon.ico
        not path /healthz
    }
    header @dynamic {
        Cache-Control "no-cache, no-store, must-revalidate"
        Pragma "no-cache"
    }

    log {
        output stdout
        format json
    }
}
