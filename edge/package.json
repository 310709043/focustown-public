{
  "name": "lowbatterytown-edge",
  "private": true,
  "version": "0.1.0",
  "description": "LowBatteryTown chat API on Cloudflare Workers (Durable Object + D1).",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:capacity": "node scripts/run-capacity.mjs",
    "test:capacity:staging": "node scripts/run-staging-capacity.mjs",
    "db:migrate": "wrangler d1 migrations apply lbt --remote"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "~0.22.0",
    "@cloudflare/workers-types": "^5.20261106.1",
    "@vitest/runner": "^4.1.12",
    "@vitest/snapshot": "^4.1.12",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^4.1.12",
    "wrangler": "^4.147.0",
    "ws": "^8.22.1"
  },
  "pnpm": {
    "overrides": {
      "sharp": "^0.35.5",
      "undici@^7": "^7.30.1",
      "zod@^4": "^4.6.6"
    }
  },
  "packageManager": "pnpm@10.28.0"
}
