{
  "name": "lowbatterytown-edge",
  "private": true,
  "version": "0.1.0",
  "description": "LowBatteryTown chat API on Cloudflare Workers (Durable Object + D1).",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:capacity": "node scripts/run-capacity.mjs",
    "db:migrate": "wrangler d1 migrations apply lbt --remote"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "~0.22.0",
    "@cloudflare/workers-types": "^5.20261003.1",
    "@vitest/runner": "^4.1.11",
    "@vitest/snapshot": "^4.1.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0"
  },
  "pnpm": {
    "overrides": {
      "sharp": "^0.35.4",
      "undici@^7": "^7.29.1"
    }
  }
}
