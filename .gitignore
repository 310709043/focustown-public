# Operator-local data (R2 upload manifests, dev fixture exports).
# Files here are inputs for one-off scripts (e.g. import-r2-manifest.py)
# and contain machine-local paths — not appropriate for source control.
backend/data/

# Playwright / test output
**/playwright/.auth/
**/playwright-report/
**/test-results/
**/.playwright/

# Generated API types are committed (regenerated via script)
!frontend/lib/api/types.gen.ts

# Reference docs and binary audio assets
reference/
*.mp3

# Exception: 5 sine-wave placeholder tracks shipped for V1 seed (Phase 2
# Gap 1 closure). These are 10-sec 64kbps sine tones (~80 KB each, ~400 KB
# total) so a fresh `docker compose up --build` doesn't leave the music
# library silent. Replace with real CC0-licensed lofi clips before
# launching public-facing.
!backend/assets/seed-tracks/cold-ceramics.mp3
!backend/assets/seed-tracks/sunlight-on-the-floor.mp3
!backend/assets/seed-tracks/cold-windowpane.mp3
!backend/assets/seed-tracks/midnight-at-the-overpass.mp3
!backend/assets/seed-tracks/sunday-window.mp3

# Exception: frontend audio fallback. These ship inside the Next.js
# image (`public/audio/`) and back ``LOCAL_FALLBACK_TRACKS`` in
# ``frontend/lib/state/audioStore.ts`` — when S3 streaming breaks
# (cold start, presigned-URL expiry, regional outage) the audio
# element swaps src to these files so the user hears something instead
# of silence. ``frontend/Dockerfile`` enforces their presence at build
# time, so omitting them silently breaks the deploy.
!frontend/public/audio/lofi-1.mp3
!frontend/public/audio/lofi-2.mp3
!frontend/public/audio/lofi-3.mp3
