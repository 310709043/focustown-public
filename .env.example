# ─── Backend ──────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-in-production-min-32-chars-long-please
APP_CORS_ORIGINS=http://localhost:3000
# Comma-separated IPs/CIDRs of proxies allowed to set X-Forwarded-For.
# Empty (default) = no trusted proxies; socket peer is always used.
APP_TRUSTED_PROXIES=

# Postgres
POSTGRES_USER=focustown
POSTGRES_PASSWORD=focustown
POSTGRES_DB=focustown
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://focustown:focustown@postgres:5432/focustown

# Redis
REDIS_URL=redis://redis:6379/0

# Auth
AUTH_PROVIDER=local_jwt
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=14

# Password reset
RESET_TOKEN_TTL_HOURS=1
RESET_URL_BASE=http://localhost:3000/reset-password
TERMS_CURRENT_VERSION=2026-05-14

# Reserved for AWS (v2)
AWS_REGION=ap-northeast-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
S3_BUCKET=

# Storage backend. Default "local" writes uploads to ./backend/data/storage.
# Set "s3" to use S3/MinIO; see docker-compose.s3.yml for a local MinIO setup.
# STORAGE_BACKEND=local
# S3_ENDPOINT_URL=http://minio:9000
# S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_PRESIGN_TTL_SECONDS=3600

# ─── Frontend ────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000
