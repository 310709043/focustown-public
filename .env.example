# ─── Backend ──────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-in-production-min-32-chars-long-please
APP_CORS_ORIGINS=http://localhost:3000
# Comma-separated IPs/CIDRs of proxies allowed to set X-Forwarded-For.
# Empty (default) = no trusted proxies; socket peer is always used.
APP_TRUSTED_PROXIES=

# Postgres
POSTGRES_USER=lowbatterytown
POSTGRES_PASSWORD=lowbatterytown
POSTGRES_DB=lowbatterytown
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://lowbatterytown:lowbatterytown@postgres:5432/lowbatterytown

# Redis
REDIS_URL=redis://redis:6379/0

# Auth
AUTH_PROVIDER=local_jwt
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=14

# Password reset
RESET_TOKEN_TTL_HOURS=1
RESET_URL_BASE=http://localhost:3000/reset-password
TERMS_CURRENT_VERSION=2026-05-14

# AWS (Cognito + SES + Secrets Manager + S3). All AWS adapters dispatch
# via env vars below so a dev container can stay on the in-process
# defaults (local_jwt / log / env / local) without touching AWS.
AWS_REGION=ap-northeast-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
# COGNITO_ENDPOINT_URL=http://localstack:4566   # local stub
# COGNITO_JWKS_TTL_SECONDS=3600
S3_BUCKET=

# Notifier dispatch. "log" writes to structured logs (no email sent);
# "ses" sends real email via AWS SESv2. Production with notifier_backend=ses
# REQUIRES ses_from_email; Settings validator enforces this at boot.
NOTIFIER_BACKEND=log
SES_FROM_EMAIL=
# SES_ENDPOINT_URL=http://localstack:4566       # local stub

# Sentry error tracking. Leave empty to disable (graceful degrade).
SENTRY_DSN=

# Feedback admin pipeline.
# ADMIN_FEEDBACK_EMAIL receives a real-time SES email on every /feedback
# submit (leave empty to disable). ADMIN_USER_IDS is the comma-separated
# allowlist that may fetch the /feedback/export.csv ledger.
ADMIN_FEEDBACK_EMAIL=
ADMIN_USER_IDS=

# Secrets dispatch. "env" reads from os.environ (default); "aws" pulls from
# Secrets Manager with an in-process TTL cache (default 5 min).
SECRETS_BACKEND=env
SECRETS_CACHE_TTL_SECONDS=300
# SECRETS_ENDPOINT_URL=http://localstack:4566   # local stub

# Storage backend. Default "local" writes uploads to ./backend/data/storage.
# Set "s3" to use S3/MinIO/R2; see docker-compose.s3.yml for a local MinIO setup.
# STORAGE_BACKEND=local
# S3_ENDPOINT_URL=http://minio:9000
# S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_PRESIGN_TTL_SECONDS=3600

# Cloudflare R2 — production audio storage. R2 is S3-compatible so the
# same backend config covers it; the only thing that changes is the
# endpoint URL. The bucket MUST be private (no public binding); reads go
# through the audio proxy Worker (see AUDIO_PROXY_* below).
#   STORAGE_BACKEND=s3
#   S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
#   S3_BUCKET=lowbatterytown-audio
#   S3_ACCESS_KEY=<R2 API token>
#   S3_SECRET_KEY=<R2 API token secret>

# Audio proxy (Cloudflare Worker). Backend issues short-TTL HS256 JWTs;
# the Worker validates them and reads R2 via its binding. The secret MUST
# match the worker's AUDIO_PROXY_SECRET (`wrangler secret put …`).
# AUDIO_PROXY_BASE_URL empty → backend /stream serves the bytes (dev /
# local-FS only). In production both are required and Settings will
# refuse to boot otherwise.
# AUDIO_PROXY_BASE_URL=https://audio.lowbatterytown.com
# AUDIO_PROXY_SECRET=$(openssl rand -hex 32)
# AUDIO_TOKEN_TTL_SECONDS=300

# Broadcast proxy (sibling Cloudflare Worker fronting a private R2 bucket
# holding the 10 town-broadcast MP4 clips). Same JWT contract as audio:
# backend mints short-TTL HS256 tokens, Worker validates and streams
# bytes. Production requires both vars; dev leaves them empty so the
# backend /broadcast/{id}/stream endpoint serves bytes off LocalFSStorage.
# BROADCAST_PROXY_BASE_URL=https://broadcast.focustown.app
# BROADCAST_PROXY_SECRET=$(openssl rand -hex 32)
# BROADCAST_TOKEN_TTL_SECONDS=300

# ─── Frontend ────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000

# Sentry DSN for frontend error tracking. Leave empty to disable.
NEXT_PUBLIC_SENTRY_DSN=

# Origins the CSP media-src directive will allow <audio>/<video> to load
# from. Defaults to NEXT_PUBLIC_API_BASE_URL when unset.
#
# Audio now flows through the Cloudflare audio Worker (AUDIO_PROXY_BASE_URL
# above), so production should whitelist that host:
#   NEXT_PUBLIC_MEDIA_ALLOWED_ORIGINS=https://audio.lowbatterytown.com
# Dev / local-FS keeps serving bytes from the backend:
#   NEXT_PUBLIC_MEDIA_ALLOWED_ORIGINS=http://localhost:8000

# Town Broadcast proxy (Cloudflare Worker, private R2). The frontend
# fetches a signed URL from /broadcast/{id}/play-token and points the
# <video> at this host. When empty the Billboard renders the
# "Programmes coming soon" fallback (no token fetch, no CSP noise).
# Must match the backend's BROADCAST_PROXY_BASE_URL.
# NEXT_PUBLIC_BROADCAST_PROXY_BASE_URL=https://broadcast.focustown.app
